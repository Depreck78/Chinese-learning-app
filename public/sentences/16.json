{"立":[["这是一所公立学校。","zhè shì yì suǒ gōng lì xué xiào ","This is a state school.","tatoeba:10643753"],["他们建立了一个网站。","tā men jiàn lì le yí gè wǎng zhàn ","They created a website.","tatoeba:13138995"],["请立刻回家。","qǐng lì kè huí jiā ","Please go home right away.","hanzi-desk"]],"及":[["我们来得及。","wǒ men lái de jí ","We have enough time.","tatoeba:398140"],["时间快来不及了。","shí jiān kuài lái bù jí le ","We're running out of time.","tatoeba:9958252"],["他及时赶到了。","tā jí shí gǎn dào le ","He arrived just in time.","hanzi-desk"]],"比":[["我比他高。","wǒ bǐ tā gāo ","I am taller than he.","tatoeba:635805"],["有比没有好。","yǒu bǐ méi yǒu hǎo ","It's better than nothing.","tatoeba:759630"],["你比她要高。","nǐ bǐ tā yào gāo ","You're taller than her.","tatoeba:2031255"]],"员":[["我是服务员。","wǒ shì fú wù yuán ","I'm a waiter.","tatoeba:10895465"],["我是个社会工作人员。","wǒ shì gè shè huì gōng zuò rén yuán ","I'm a social worker.","tatoeba:2771148"],["他们是飞行员。","tā men shì fēi xíng yuán ","They are pilots.","tatoeba:13675153"]],"解":[["你不了解。","nǐ bù liǎo jiě ","You don't understand.","tatoeba:792405"],["他们和解了，并再次成为了朋友。","tā men hé jiě le  bìng zài cì chéng wéi le péng yǒu ","They made up and became friends again.","tatoeba:795812"],["我能理解你的感受。","wǒ néng lǐ jiě nǐ de gǎn shòu ","I can understand how you feel.","hanzi-desk"]],"论":[["我是无神论者。","wǒ shì wú shén lùn zhě ","I'm atheist.","tatoeba:7771867"],["无论如何说不通。","wú lùn rú hé shuō bù tōng ","It makes no sense whatsoever.","tatoeba:5640752"],["不论你有没有钱，我都爱你。","bú lùn nǐ yǒu méi yǒu qián  wǒ dōu ài nǐ ","It doesn't matter whether you have money or not. I love you just the same.","tatoeba:381415"]],"处":[["四处看看。","sì chù kàn kàn ","Look around.","tatoeba:5092470"],["我处理了。","wǒ chǔ lǐ le ","I handled it.","tatoeba:13109034"],["他很好相处。","tā hěn hǎo xiāng chǔ ","He is easy to get along with.","tatoeba:1578944"]],"义":[["他想要正义。","tā xiǎng yào zhèng yì ","He wants justice.","tatoeba:5555122"],["这没有任何意义。","zhè méi yǒu rèn hé yì yì ","That doesn't make sense.","tatoeba:346785"],["他是一个很讲义气的人。","tā shì yí gè hěn jiǎng yì qì de rén ","He's very loyal to his friends.","hanzi-desk"]],"各":[["请每种各给我三个。","qǐng měi zhǒng gè gěi wǒ sān gè ","Please give me three of each kind.","tatoeba:13850428"],["每位学生都各有所见。","měi wèi xué shēng dōu gè yǒu suǒ jiàn ","Each of these students has his or her own opinion.","tatoeba:12379685"],["他在各方面都比不上你。","tā zài gè fāng miàn dōu bǐ bú shàng nǐ ","He is inferior to you in all respects.","tatoeba:718453"]],"入":[["我无法入睡。","wǒ wú fǎ rù shuì ","I couldn't sleep.","tatoeba:833041"],["请加入我们。","qǐng jiā rù wǒ men ","Please join us.","tatoeba:6150018"],["马上就要入秋了。","mǎ shàng jiù yào rù qiū le ","Autumn is just around the corner.","tatoeba:2312543"]],"认":[["你认为如何？","nǐ rèn wéi rú hé ","What do you think?","tatoeba:735175"],["我无法认同你。","wǒ wú fǎ rèn tóng nǐ ","I cannot agree with you.","tatoeba:335416"],["他弟弟很认真学习。","tā dì di hěn rèn zhēn xué xí ","His brother studies hard.","tatoeba:3488702"]],"条":[["我有一条狗。","wǒ yǒu yì tiáo gǒu ","I have a dog.","tatoeba:414228"],["我很有条理。","wǒ hěn yǒu tiáo lǐ ","I'm very methodical.","tatoeba:8795190"],["我喜欢吃面条。","wǒ xǐ huan chī miàn tiáo ","I like eating noodles.","hanzi-desk"]],"平":[["这不公平。","zhè bù gōng píng ","That isn't fair.","tatoeba:819322"],["一路平安！","yí lù píng ān ","Bon voyage!","tatoeba:1216125"],["我们都希望世界和平。","wǒ men dōu xī wàng shì jiè hé píng ","We all hope for world peace.","hanzi-desk"]],"气":[["他生气了。","tā shēng qì le ","He got angry.","tatoeba:389804"],["天气好冷。","tiān qì hǎo lěng ","It's freezing.","tatoeba:803735"],["我气坏了。","wǒ qì huài le ","I couldn't control my anger.","tatoeba:5945149"]],"题":[["回答问题。","huí dá wèn tí ","Answer the question.","tatoeba:777935"],["他小题大作。","tā xiǎo tí dà zuò ","He makes mountains out of molehills.","tatoeba:969912"],["这道题目没有一位老师会做。","zhè dào tí mù méi yǒu yí wèi lǎo shī huì zuò ","None of the teachers could solve the problem.","tatoeba:493469"]],"活":[["我想活着。","wǒ xiǎng huó zhe ","I want to live.","tatoeba:1166894"],["她会活下来。","tā huì huó xià lái ","She will survive.","tatoeba:10301646"],["我很喜欢这里的生活。","wǒ hěn xǐ huan zhè lǐ de shēng huó ","I really like life here.","hanzi-desk"]],"更":[["那更好吗？","nà gèng hǎo ma ","Is that better?","tatoeba:5670784"],["您比我更高。","nín bǐ wǒ gèng gāo ","You're even taller than I am.","tatoeba:2353491"],["我想要更多。","wǒ xiǎng yào gèng duō ","I want more.","tatoeba:3742594"]],"别":[["别说这个。","bié shuō zhè ge ","Don't say that.","tatoeba:669008"],["别再说了！","bié zài shuō le ","Don't say anymore!","tatoeba:5370600"],["别担心。","bié dān xīn ","Don't worry.","hanzi-desk"]],"打":[["请打开窗。","qǐng dǎ kāi chuāng ","Open the window.","tatoeba:337290"],["她打了他。","tā dǎ le tā ","She hit him.","tatoeba:5670795"],["打电话回家！","dǎ diàn huà huí jiā ","Call home!","tatoeba:5092540"]],"变":[["雨变小了。","yǔ biàn xiǎo le ","The rain is letting up.","tatoeba:5670855"],["我在变老。","wǒ zài biàn lǎo ","I'm getting old.","tatoeba:7768006"],["天气变冷了。","tiān qì biàn lěng le ","The weather has turned cold.","hanzi-desk"]],"神":[["他不信神。","tā bú xìn shén ","He doesn't believe in God.","tatoeba:6903858"],["神无处不在。","shén wú chù bú zài ","God is everywhere.","tatoeba:6325113"],["他今天很有精神。","tā jīn tiān hěn yǒu jīng shén ","He's full of energy today.","hanzi-desk"]],"总":[["他总是在笑。","tā zǒng shì zài xiào ","He's always smiling.","tatoeba:334059"],["笑总比哭好。","xiào zǒng bǐ kū hǎo ","It's better to laugh than to cry.","tatoeba:10552176"],["他不是总来晚。","tā bú shì zǒng lái wǎn ","He doesn't always come late.","tatoeba:1450502"]],"何":[["你认为如何？","nǐ rèn wéi rú hé ","What do you think?","tatoeba:735175"],["我没任何零钱。","wǒ méi rèn hé líng qián ","I don't have any change.","tatoeba:334618"],["我们何不回家呢？","wǒ men hé bù huí jiā ne ","Why don't we go home?","tatoeba:334555"]],"安":[["一路平安！","yí lù píng ān ","Bon voyage!","tatoeba:1216125"],["这不安全。","zhè bù ān quán ","This isn't safe.","tatoeba:2440681"],["晚安！","wǎn ān ","Good night!","hanzi-desk"]],"报":[["恶有恶报。","è yǒu è bào ","What goes around comes around.","tatoeba:816685"],["报纸在哪儿？","bào zhǐ zài nǎ ér ","Where is the newspaper?","tatoeba:348608"],["我要报警了！","wǒ yào bào jǐng le ","I'm gonna call the police!","tatoeba:4638683"]],"才":[["这样才对！","zhè yàng cái duì ","That's right!","tatoeba:1705773"],["我很晚才睡。","wǒ hěn wǎn cái shuì ","I stayed up till late at night.","tatoeba:344235"],["他八点才起床。","tā bā diǎn cái qǐ chuáng ","He didn't get up until eight.","hanzi-desk"]],"结":[["这没有结果。","zhè méi yǒu jié guǒ ","It came to nothing.","tatoeba:336587"],["没有人知道战争何时会完结。","méi yǒu rén zhī dào zhàn zhēng hé shí huì wán jié ","Nobody can foresee when the war will end.","tatoeba:472116"],["感觉这不会有个好结局。","gǎn jué zhè bú huì yǒu gè hǎo jié jú ","I feel like this isn't going to end well.","tatoeba:8686669"]],"反":[["反正一样。","fǎn zhèng yí yàng ","Makes no difference anyway.","tatoeba:9833741"],["是说反话吗？","shì shuō fǎn huà ma ","Are you being sarcastic?","tatoeba:2453176"],["有三票反对。","yǒu sān piào fǎn duì ","Three voted against the idea.","tatoeba:5558543"]],"受":[["我受不了他。","wǒ shòu bù liǎo tā ","I can't stand him.","tatoeba:782167"],["她被接受了。","tā bèi jiē shòu le ","She got accepted.","tatoeba:13709581"],["来感受一下这个。","lái gǎn shòu yí xià zhè ge ","Feel this.","tatoeba:5092677"]],"目":[["您过目一下。","nín guò mù yí xià ","Please take a look.","tatoeba:14038330"],["目前我问题很多。","mù qián wǒ wèn tí hěn duō ","I have a lot of problems at the moment.","tatoeba:784577"],["这道题目没有一位老师会做。","zhè dào tí mù méi yǒu yí wèi lǎo shī huì zuò ","None of the teachers could solve the problem.","tatoeba:493469"]]}
