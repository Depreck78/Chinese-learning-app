oeba:6940172"],["我们没有洗碗机。","wǒ men méi yǒu xǐ wǎn jī ","We don't have a dishwasher.","tatoeba:10573630"]],"穿":[["我不知道要穿什么。","wǒ bù zhī dào yào chuān shén me ","I have no idea what to wear.","tatoeba:6047505"],["请穿衣服。","qǐng chuān yī fu ","Please get dressed.","tatoeba:819702"],["今天很冷，多穿点衣服。","jīn tiān hěn lěng  duō chuān diǎn yī fu ","It's cold today, so wear more clothes.","hanzi-desk"]],"吃":[["请吃点菜。","qǐng chī diǎn cài ","Please eat something.","tatoeba:402752"],["我只吃肉。","wǒ zhǐ chī ròu ","I only eat meat.","tatoeba:843486"],["你想吃什么？","nǐ xiǎng chī shén me ","What would you like to eat?","hanzi-desk"]],"喝":[["不要喝酒。","bú yào hē jiǔ ","Don't drink alcohol.","tatoeba:345668"],["我不喝水。","wǒ bù hē shuǐ ","I don't drink water.","tatoeba:843489"],["我也喝茶。","wǒ yě hē chá ","I drink tea, too.","tatoeba:3378129"]],"饭":[["他在吃饭。","tā zài chī fàn ","He is eating.","tatoeba:1163518"],["饭做好了。","fàn zuò hǎo le ","The food's ready.","tatoeba:2307383"],["她会做饭。","tā huì zuò fàn ","She knows how to cook.","tatoeba:2934370"]],"米":[["我在吃米饭。","wǒ zài chī mǐ fàn ","I'm eating rice.","tatoeba:334506"],["我有一米九高。","wǒ yǒu yì mǐ jiǔ gāo ","I'm 1.9 meters tall.","tatoeba:493929"],["鸟喜欢大米。","niǎo xǐ huan dà mǐ ","The bird likes rice.","tatoeba:670862"]],"面":[["我在吃面。","wǒ zài chī miàn ","I'm eating noodles.","tatoeba:1140695"],["零在一前面。","líng zài yì qián miàn ","Zero comes before one.","tatoeba:816566"],["你去外面吗？","nǐ qù wài miàn ma ","Are you going outside?","tatoeba:3780477"]],"菜":[["请吃点菜。","qǐng chī diǎn cài ","Please eat something.","tatoeba:402752"],["是日本菜吗？","shì rì běn cài ma ","Is it Japanese food?","tatoeba:868284"],["这是中国菜。","zhè shì zhōng guó cài ","This is Chinese food.","tatoeba:3377911"]],"肉":[["我只吃肉。","wǒ zhǐ chī ròu ","I only eat meat.","tatoeba:843486"],["这是鸡肉。","zhè shì jī ròu ","This is chicken.","tatoeba:9489484"],["不要吃猪肉。","bú yào chī zhū ròu ","Don't eat pork.","tatoeba:13543756"]],"鱼":[["这不是鱼。","zhè bú shì yú ","This is not fish.","tatoeba:5722738"],["他们吃鱼。","tā men chī yú "