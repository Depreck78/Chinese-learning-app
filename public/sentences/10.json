{"湖":[["这个湖里有很多鱼。","zhè ge hú lǐ yǒu hěn duō yú ","Fish abound in this lake.","tatoeba:907518"],["湖和河里全是鱼。","hú hé hé lǐ quán shì yú ","The lakes and rivers, too, are full of fish.","tatoeba:10171219"],["在湖边度假。","zài hú biān dù jià ","We had our vacation at the lake.","tatoeba:348613"]],"海":[["鱼在海里。","yú zài hǎi lǐ ","The fish are in the sea.","tatoeba:3377879"],["我是上海人。","wǒ shì shàng hǎi rén ","I'm Shanghainese.","tatoeba:347342"],["我喜欢在海边玩。","wǒ xǐ huan zài hǎi biān wán ","I like playing by the sea.","hanzi-desk"]],"地":[["谢天谢地。","xiè tiān xiè dì ","Thank God.","tatoeba:10645538"],["他坐在地上。","tā zuò zài dì shàng ","He was sitting on the floor.","tatoeba:799117"],["他是本地人。","tā shì běn dì rén ","He is a local.","tatoeba:9954763"]],"云":[["那晚多云。","nà wǎn duō yún ","It was cloudy that night.","tatoeba:346116"],["天上没有云。","tiān shàng méi yǒu yún ","There is no cloud in the sky.","tatoeba:335530"],["云开见天日。","yún kāi jiàn tiān rì ","The clouds opened and the sun shone through.","tatoeba:336958"]],"雨":[["雨下了一周。","yǔ xià le yì zhōu ","It rained for a week.","tatoeba:333989"],["外面在下雨。","wài miàn zài xià yǔ ","It's raining outside.","hanzi-desk"],["昨天下了很大的雨。","zuó tiān xià le hěn dà de yǔ ","It rained heavily yesterday.","hanzi-desk"]],"雪":[["今天下雪。","jīn tiān xià xuě ","It's snowy today.","tatoeba:776959"],["昨晚下了雪。","zuó wǎn xià le xuě ","It snowed last night.","tatoeba:8800811"],["雪下了一周。","xuě xià le yì zhōu ","It snowed all week.","tatoeba:13504857"]],"风":[["今天有风。","jīn tiān yǒu fēng ","It's windy today.","tatoeba:510694"],["外面风很大。","wài miàn fēng hěn dà ","It's windy outside.","tatoeba:13552173"],["春天的风很舒服。","chūn tiān de fēng hěn shū fú ","The spring breeze is pleasant.","hanzi-desk"]],"雾":[["外面有雾。","wài miàn yǒu wù ","It's foggy out.","tatoeba:13556507"],["今天早上起雾了。","jīn tiān zǎo shàng qǐ wù le ","This morning was foggy.","tatoeba:5957546"],["今天雾很大。","jīn tiān wù hěn dà ","It's quite foggy today.","tatoeba:13556505"]],"冷":[["这里很冷。","zhè lǐ hěn lěng ","It's very cold here.","tatoeba:381930"],["你不冷吗？","nǐ bù lěng ma ","Aren't you cold?","tatoeba:8673739"],["冬天这里很冷。","dōng tiān zhè lǐ hěn lěng ","It's very cold here in winter.","hanzi-desk"]],"热":[["今天很热。","jīn tiān hěn rè ","Today is very warm.","tatoeba:343752"],["你不热吗？","nǐ bú rè ma ","Aren't you hot?","tatoeba:4956714"],["热一点水。","rè yì diǎn shuǐ ","Warm up some water.","tatoeba:10644868"]],"阴":[["今天是个阴天。","jīn tiān shì gè yīn tiān ","Today is a cloudy day.","tatoeba:4625757"],["天气变阴了。","tiān qì biàn yīn le ","It's turned cloudy.","tatoeba:761057"],["阴天的时候我不想出门。","yīn tiān de shí hòu wǒ bù xiǎng chū mén ","I don't feel like going out on cloudy days.","hanzi-desk"]],"阳":[["太阳下山了。","tài yáng xià shān le ","The sun is setting.","tatoeba:9501215"],["我在阳台上。","wǒ zài yáng tái shàng ","I'm on the balcony.","tatoeba:9037053"],["今天阳光很好。","jīn tiān yáng guāng hěn hǎo ","It's lovely and sunny today.","hanzi-desk"]],"石":[["一石二鸟。","yì shí èr niǎo ","Kill two birds with one stone.","tatoeba:401900"],["这是什么石头？","zhè shì shén me shí tou ","What kind of stone is this?","tatoeba:5613672"],["日本靠阿拉伯国家提供石油。","rì běn kào ā lā bó guó jiā tí gōng shí yóu ","Japan relies on Arab countries for oil.","tatoeba:333498"]],"土":[["那是土星。","nà shì tǔ xīng ","That is Saturn.","tatoeba:6961295"],["放眼全球，立足本土。","fàng yǎn quán qiú  lì zú běn tǔ ","Think global, act local.","tatoeba:13180351"],["小狗身上都是土。","xiǎo gǒu shēn shàng dōu shì tǔ ","The puppy is covered in dirt.","hanzi-desk"]],"木":[["这是张木桌。","zhè shì zhāng mù zhuō ","This is a wooden table.","tatoeba:785840"],["一个木头碗。","yí gè mù tou wǎn ","A wooden bowl.","tatoeba:2915620"],["这把椅子是木头做的。","zhè bǎ yǐ zi shì mù tou zuò de ","This chair is made of wood.","hanzi-desk"]],"林":[["马在林中。","mǎ zài lín zhōng ","The horse is in the forest.","tatoeba:10481690"],["林老师，明天您在学校吗？","lín lǎo shī  míng tiān nín zài xué xiào ma ","Mr Lin, will you be at school tomorrow?","tatoeba:6486873"],["林子大了什么鸟都有。","lín zi dà le shén me niǎo dōu yǒu ","There are all kinds of people in the world.","tatoeba:400564"]],"花":[["花都谢了。","huā dōu xiè le ","The flowers have all withered.","tatoeba:459394"],["这是花吗？","zhè shì huā ma ","Is this a flower?","tatoeba:1187312"],["我买了花。","wǒ mǎi le huā ","I bought flowers.","tatoeba:11508980"]],"草":[["不要走在草地上。","bú yào zǒu zài cǎo dì shàng ","Stay off the grass.","tatoeba:766952"],["又要马儿好，又要马儿不吃草。","yòu yào mǎ ér hǎo  yòu yào mǎ ér bù chī cǎo ","You want the horse to run fast, but you don't want to feed it grass.","tatoeba:14011829"],["看，一片四叶草！","kàn  yí piàn sì yè cǎo ","Look! A four-leafed clover!","tatoeba:13885386"]],"鸟":[["一石二鸟。","yì shí èr niǎo ","Kill two birds with one stone.","tatoeba:401900"],["鸟在天上。","niǎo zài tiān shàng ","The bird is in the sky.","tatoeba:9096132"],["这儿有只鸟。","zhè ér yǒu zhī niǎo ","There is a bird here.","tatoeba:10563975"]],"虫":[["你怕虫子吗？","nǐ pà chóng zǐ ma ","Are you afraid of bugs?","tatoeba:4813407"],["树上有很多虫子。","shù shàng yǒu hěn duō chóng zǐ ","There are lots of insects in the tree.","hanzi-desk"],["这只小虫子会飞。","zhè zhī xiǎo chóng zǐ huì fēi ","This little bug can fly.","hanzi-desk"]],"狗":[["我没有狗。","wǒ méi yǒu gǒu ","I don't have a dog.","tatoeba:7772409"],["你有四只狗。","nǐ yǒu sì zhī gǒu ","You have four dogs.","tatoeba:558665"],["我家的狗很可爱。","wǒ jiā de gǒu hěn kě ài ","Our dog is very cute.","hanzi-desk"]],"猫":[["我没有猫。","wǒ méi yǒu māo ","I don't have a cat.","tatoeba:407226"],["这是猫吗？","zhè shì māo ma ","Is that a cat?","tatoeba:1123530"],["猫在哪里？","māo zài nǎ lǐ ","Where's the cat?","tatoeba:1851461"]],"马":[["马上上马！","mǎ shàng shàng mǎ ","Get on the horse immediately!","tatoeba:2220573"],["这只是马。","zhè zhǐ shì mǎ ","This is only a horse.","tatoeba:2561557"],["他们有马。","tā men yǒu mǎ ","They have a horse.","tatoeba:5640763"]],"牛":[["没牛奶了。","méi niú nǎi le ","There's no more milk.","tatoeba:345919"],["我有一头母牛。","wǒ yǒu yì tóu mǔ niú ","I have a cow.","tatoeba:2777842"],["“我也要牛肉。”"," wǒ yě yào niú ròu  ","I want beef, too.","tatoeba:780397"]],"羊":[["比起羊肉我更喜欢牛肉。","bǐ qǐ yáng ròu wǒ gèng xǐ huan niú ròu ","I like beef more than lamb.","tatoeba:9007593"],["羊群在草地上吃着草。","yáng qún zài cǎo dì shàng chī zhe cǎo ","Sheep are feeding in the meadow.","tatoeba:1016761"],["她穿着羊毛衣。","tā chuān zhe yáng máo yī ","She was dressed in wool.","tatoeba:844458"]],"猪":[["不要吃猪肉。","bú yào chī zhū ròu ","Don't eat pork.","tatoeba:13543756"],["我昨天买了这头猪。","wǒ zuó tiān mǎi le zhè tóu zhū ","I bought the pig yesterday.","tatoeba:2737460"],["小猪在睡觉。","xiǎo zhū zài shuì jiào ","The piglet is sleeping.","hanzi-desk"]],"鸡":[["这是鸡肉。","zhè shì jī ròu ","This is chicken.","tatoeba:9489484"],["我吃不下鸡皮。","wǒ chī bú xià jī pí ","I don't eat chicken skin.","tatoeba:2031425"],["请问鸡蛋在哪里？","qǐng wèn jī dàn zài nǎ lǐ ","Where are the eggs, please?","tatoeba:334425"]],"兔":[["我喜欢兔子。","wǒ xǐ huan tù zi ","I like rabbits.","tatoeba:7774808"],["徒手逮兔挺难。","tú shǒu dǎi tù tǐng nán ","It's difficult to catch a rabbit by hand.","tatoeba:896358"],["兔子喜欢吃胡萝卜。","tù zi xǐ huan chī hú luó bo ","Rabbits like eating carrots.","hanzi-desk"]],"虎":[["那不是老虎。","nà bú shì lǎo hǔ ","That is not a tiger.","tatoeba:340500"],["我小睡后就感到生龙活虎。","wǒ xiǎo shuì hòu jiù gǎn dào shēng lóng huó hǔ ","A little nap and, just like that, I'm as fresh as a daisy.","tatoeba:410802"],["老虎是很危险的动物。","lǎo hǔ shì hěn wēi xiǎn de dòng wù ","Tigers are very dangerous animals.","hanzi-desk"]],"龙":[["我喜欢火龙果。","wǒ xǐ huan huǒ lóng guǒ ","I like dragon fruit.","tatoeba:5715134"],["中国人喜欢龙。","zhōng guó rén xǐ huan lóng ","Chinese people love dragons.","hanzi-desk"],["龙是中国文化的象征。","lóng shì zhōng guó wén huà de xiàng zhēng ","The dragon is a symbol of Chinese culture.","hanzi-desk"]]}
