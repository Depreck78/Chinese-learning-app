ney important to you?","tatoeba:10551877"],["这个石头很重。","zhè ge shí tou hěn zhòng ","The stone is heavy.","tatoeba:4869680"]],"黑":[["天快黑了。","tiān kuài hēi le ","It will be dark soon.","tatoeba:3060526"],["这不是小黑吗？","zhè bú shì xiǎo hēi ma ","This isn't Little Black is it?","tatoeba:1644800"],["黑猫在吃白鼠。","hēi māo zài chī bái shǔ ","The black cat is eating the white mouse.","tatoeba:1888699"]],"白":[["我不明白。","wǒ bù míng bái ","I don't get it.","tatoeba:340435"],["那时是白天。","nà shí shì bái tiān ","It was daytime.","tatoeba:10484361"],["他有一只白猫。","tā yǒu yì zhī bái māo ","He has a white cat.","tatoeba:1300402"]],"红":[["她脸红了。","tā liǎn hóng le ","Her face turned red.","tatoeba:396112"],["卖红酒吗？","mài hóng jiǔ ma ","Sell wine?","tatoeba:6092788"],["喝杯红茶吗？","hē bēi hóng chá ma ","How about a cup of tea?","tatoeba:338415"]],"黄":[["我爱蛋黄。","wǒ ài dàn huáng ","I love egg yolks.","tatoeba:4546932"],["树叶变黄了。","shù yè biàn huáng le ","The leaves have turned yellow.","tatoeba:1323412"],["我喜欢黄色。","wǒ xǐ huan huáng sè ","I like yellow.","tatoeba:8853706"]],"蓝":[["你知道为什么天看起来这么蓝吗？","nǐ zhī dào wèi shén me tiān kàn qǐ lái zhè me lán ma ","Do you know why the sky looks so blue?","tatoeba:9958259"],["我喜欢蓝色。","wǒ xǐ huan lán sè ","I like blue.","tatoeba:3378086"],["她有双蓝眼睛。","tā yǒu shuāng lán yǎn jīng ","She has blue eyes.","tatoeba:2672796"]],"绿":[["你喝绿茶吗？","nǐ hē lǜ chá ma ","Do you drink green tea?","tatoeba:2782917"],["现在是绿灯。","xiàn zài shì lǜ dēng ","The light is green.","tatoeba:3718214"],["这树全年常绿。","zhè shù quán nián cháng lǜ ","The tree is green all year round.","tatoeba:7768333"]]}
