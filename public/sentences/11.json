{"蛇":[["他一点也不怕蛇。","tā yì diǎn yě bú pà shé ","He's not at all afraid of snakes.","tatoeba:889637"],["“你喜欢蛇吗？”“当然不喜欢。”"," nǐ xǐ huan shé ma    dāng rán bù xǐ huan  ","\"Do you like snakes?\" \"Of course not.\"","tatoeba:399896"],["蛇年开始了。","shé nián kāi shǐ le ","The year of the snake has begun.","tatoeba:3377935"]],"猴":[["山上发现了不少猴子。","shān shàng fā xiàn le bù shǎo hóu zi ","Not a few monkeys were found in the mountain.","tatoeba:343257"],["猴子喜欢吃香蕉。","hóu zi xǐ huan chī xiāng jiāo ","Monkeys like eating bananas.","hanzi-desk"],["动物园里有很多猴子。","dòng wù yuán lǐ yǒu hěn duō hóu zi ","There are lots of monkeys at the zoo.","hanzi-desk"]],"鼠":[["猫吃了老鼠。","māo chī le lǎo shǔ ","The cat ate the rat.","tatoeba:2333759"],["黑猫在吃白鼠。","hēi māo zài chī bái shǔ ","The black cat is eating the white mouse.","tatoeba:1888699"],["要不要买个无线鼠标呢？","yào bu yào mǎi gè wú xiàn shǔ biāo ne ","Should I buy a wireless mouse?","tatoeba:10041929"]],"树":[["树在哪里？","shù zài nǎ lǐ ","Where is the tree?","tatoeba:4761858"],["这些树很美。","zhè xiē shù hěn měi ","These trees are beautiful.","tatoeba:10752905"],["乡间有很多树。","xiāng jiān yǒu hěn duō shù ","The countryside has many trees.","tatoeba:332921"]],"叶":[["树叶变黄了。","shù yè biàn huáng le ","The leaves have turned yellow.","tatoeba:1323412"],["这些绿叶到秋天变成红色或黄色。","zhè xiē lǜ yè dào qiū tiān biàn chéng hóng sè huò huáng sè ","These green leaves turn red or yellow in fall.","tatoeba:392236"],["秋天的叶子很漂亮。","qiū tiān de yè zi hěn piào liang ","Leaves are beautiful in autumn.","hanzi-desk"]],"大":[["我家很大。","wǒ jiā hěn dà ","My house is big.","tatoeba:336235"],["他多大了？","tā duō dà le ","How old is he?","tatoeba:454259"],["大家好吗？","dà jiā hǎo ma ","How's everyone?","tatoeba:819309"]],"小":[["走路小心。","zǒu lù xiǎo xīn ","Watch your step.","tatoeba:826192"],["我是小雨。","wǒ shì xiǎo yǔ ","I am Xiaoyu.","tatoeba:6142021"],["我的房间很小。","wǒ de fáng jiān hěn xiǎo ","My room is very small.","hanzi-desk"]],"高":[["你有多高？","nǐ yǒu duō gāo ","How tall are you?","tatoeba:393593"],["他没你高。","tā méi nǐ gāo ","He's not as tall as you are.","tatoeba:877661"],["我个子高。","wǒ gè zi gāo ","I'm tall.","tatoeba:7772132"]],"矮":[["我个头矮。","wǒ gè tóu ǎi ","I am short.","tatoeba:4265202"],["你没我矮。","nǐ méi wǒ ǎi ","You are not as short as I.","tatoeba:10272080"],["我太矮了。","wǒ tài ǎi le ","I am too short.","tatoeba:512866"]],"长":[["这有多长？","zhè yǒu duō cháng ","How long is this?","tatoeba:826260"],["说来话长。","shuō lái huà cháng ","It's a long story.","tatoeba:1565704"],["他是长子。","tā shì zhǎng zǐ ","He's the oldest son.","tatoeba:7768239"]],"短":[["我喜欢短发。","wǒ xǐ huan duǎn fà ","I like short hair.","tatoeba:414239"],["外语很多，时间很短。","wài yǔ hěn duō  shí jiān hěn duǎn ","So many languages, so little time...","tatoeba:4047395"],["这条裤子太短了。","zhè tiáo kù zǐ tài duǎn le ","These trousers are too short.","hanzi-desk"]],"胖":[["你有点胖。","nǐ yǒu diǎn pàng ","You are a bit fat.","tatoeba:9932536"],["他胖起来了。","tā pàng qǐ lái le ","He has gotten fat.","tatoeba:4931168"],["我最近胖了两公斤。","wǒ zuì jìn pàng le liǎng gōng jīn ","I've put on two kilos recently.","hanzi-desk"]],"瘦":[["你瘦了吗？","nǐ shòu le ma ","Did you lose weight?","tatoeba:10314344"],["这个女人很瘦。","zhè ge nǚ rén hěn shòu ","This woman is very thin.","tatoeba:779509"],["他看来每天都在变瘦。","tā kàn lái měi tiān dōu zài biàn shòu ","He seemed to be getting thinner every day.","tatoeba:5624905"]],"坏":[["电脑坏了。","diàn nǎo huài le ","The computer is broken.","tatoeba:693742"],["他好坏不分。","tā hǎo huài bù fēn ","He doesn't know the difference between right and wrong.","tatoeba:1330048"],["你是个坏孩子。","nǐ shì gè huài hái zi ","You're a bad child.","tatoeba:1325102"]],"真":[["那个真好。","nà ge zhēn hǎo ","That one is really good.","tatoeba:6169153"],["今天真热。","jīn tiān zhēn rè ","It's really hot today.","hanzi-desk"],["你真好！","nǐ zhēn hǎo ","You're so kind!","hanzi-desk"]],"假":[["这是假发。","zhè shì jiǎ fà ","This is a wig.","tatoeba:5637367"],["她请了天假。","tā qǐng le tiān jiǎ ","She's taken a day off.","tatoeba:10518605"],["我这个星期放假了。","wǒ zhè ge xīng qī fàng jià le ","I'm on holiday this week.","tatoeba:359530"]],"美":[["他是美国人。","tā shì měi guó rén ","He's American.","tatoeba:332941"],["你是个美人。","nǐ shì gè měi rén ","You're a beautiful woman.","tatoeba:3671259"],["他给他四美元。","tā gěi tā sì měi yuán ","He paid him four dollars.","tatoeba:5576834"]],"丑":[["这把椅子很丑。","zhè bǎ yǐ zi hěn chǒu ","This chair is ugly.","tatoeba:793289"],["这件衣服有点丑。","zhè jiàn yī fu yǒu diǎn chǒu ","This piece of clothing is a bit ugly.","hanzi-desk"],["丑小鸭变成了白天鹅。","chǒu xiǎo yā biàn chéng le bái tiān é ","The ugly duckling turned into a white swan.","hanzi-desk"]],"新":[["我是个新生。","wǒ shì gè xīn shēng ","I'm a new student.","tatoeba:347055"],["我没钱买新车。","wǒ méi qián mǎi xīn chē ","I can't afford to buy a new car.","tatoeba:372206"],["他写了本新书。","tā xiě le běn xīn shū ","He wrote a new book.","tatoeba:3742513"]],"旧":[["那本书很旧。","nà běn shū hěn jiù ","That book is very old.","tatoeba:769623"],["这个商店卖旧书。","zhè ge shāng diàn mài jiù shū ","This store sells old books.","tatoeba:2298527"],["您喜欢旧金山吗？","nín xǐ huan jiù jīn shān ma ","Do you like San Francisco?","tatoeba:2219165"]],"快":[["我快走了。","wǒ kuài zǒu le ","I'm about to leave.","tatoeba:400812"],["快来这里。","kuài lái zhè lǐ ","Come here quickly.","tatoeba:897264"],["快三点了。","kuài sān diǎn le ","It's almost three o'clock.","hanzi-desk"]],"慢":[["开车慢点。","kāi chē màn diǎn ","Drive slowly.","tatoeba:5092212"],["请慢慢说。","qǐng màn màn shuō ","Please speak slowly.","tatoeba:13192530"],["我上午慢跑。","wǒ shàng wǔ màn pǎo ","I jog in the morning.","tatoeba:3695646"]],"轻":[["他很年轻。","tā hěn nián qīng ","He is very young.","tatoeba:1433839"],["轻一点儿放！","qīng yì diǎn ér fàng ","Put it down lightly!","tatoeba:420002"],["我轻轻地对她说：“不要怕，我在这儿。”","wǒ qīng qīng de duì tā shuō   bú yào pà  wǒ zài zhè ér  ","I whispered to her, \"Don't be afraid, I'm here.\"","hanzi-desk"]],"重":[["这不重要。","zhè bú zhòng yào ","It's not important.","tatoeba:1415838"],["你看重钱吗？","nǐ kàn zhòng qián ma ","Is money important to you?","tatoeba:10551877"],["这个石头很重。","zhè ge shí tou hěn zhòng ","The stone is heavy.","tatoeba:4869680"]],"黑":[["天快黑了。","tiān kuài hēi le ","It will be dark soon.","tatoeba:3060526"],["这不是小黑吗？","zhè bú shì xiǎo hēi ma ","Isn't that Xiaohei?","tatoeba:1644800"],["黑猫在吃白鼠。","hēi māo zài chī bái shǔ ","The black cat is eating the white mouse.","tatoeba:1888699"]],"白":[["我不明白。","wǒ bù míng bái ","I don't get it.","tatoeba:340435"],["那时是白天。","nà shí shì bái tiān ","It was daytime.","tatoeba:10484361"],["他有一只白猫。","tā yǒu yì zhī bái māo ","He has a white cat.","tatoeba:1300402"]],"红":[["她脸红了。","tā liǎn hóng le ","Her face turned red.","tatoeba:396112"],["卖红酒吗？","mài hóng jiǔ ma ","Do you sell red wine?","tatoeba:6092788"],["喝杯红茶吗？","hē bēi hóng chá ma ","Would you like a cup of black tea?","tatoeba:338415"]],"黄":[["我爱蛋黄。","wǒ ài dàn huáng ","I love egg yolks.","tatoeba:4546932"],["树叶变黄了。","shù yè biàn huáng le ","The leaves have turned yellow.","tatoeba:1323412"],["我喜欢黄色。","wǒ xǐ huan huáng sè ","I like yellow.","tatoeba:8853706"]],"蓝":[["你知道为什么天看起来这么蓝吗？","nǐ zhī dào wèi shén me tiān kàn qǐ lái zhè me lán ma ","Do you know why the sky looks so blue?","tatoeba:9958259"],["我喜欢蓝色。","wǒ xǐ huan lán sè ","I like blue.","tatoeba:3378086"],["她有双蓝眼睛。","tā yǒu shuāng lán yǎn jīng ","She has blue eyes.","tatoeba:2672796"]],"绿":[["你喝绿茶吗？","nǐ hē lǜ chá ma ","Do you drink green tea?","tatoeba:2782917"],["现在是绿灯。","xiàn zài shì lǜ dēng ","The light is green.","tatoeba:3718214"],["这树全年常绿。","zhè shù quán nián cháng lǜ ","The tree is green all year round.","tatoeba:7768333"]]}
