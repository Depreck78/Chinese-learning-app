{"packs":["92-0-04365335.mp3","92-1-73dea593.mp3","92-2-d84732e5.mp3"],"readings":["f1b761b7f4d1","d6c0029f2603","484b8b1a94ce"],"clips":{"他在房间里踱来踱去。":[0,0.05,3.127],"老人慢慢地踱到门口。":[0,3.527,2.95],"他一边踱步一边想问题。":[0,6.828,3.349],"我的手肘还在痛。":[0,10.526,2.451],"汤姆碰了我的胳膊肘。":[0,13.328,2.947],"不要把你的手肘放在桌子上。":[0,16.625,3.585],"工人们把铁熔成了铁水。":[0,20.559,3.128],"火山里有熔岩。":[0,24.038,2.181],"铁在高温下会熔化。":[0,26.568,2.831],"这段旋律的演绎真是完美无瑕。":[0,29.749,4.076],"游客络绎不绝。":[0,34.175,2.181],"这个演员演绎得很好。":[0,36.706,2.781],"我喜欢吃肉脯。":[0,39.837,2.256],"他挺着胸脯走了进来。":[0,42.443,3.029],"这是用鸡脯肉做的菜。":[0,45.822,3.008],"他叫苦不迭。":[0,49.179,1.921],"季节更迭，时间过得很快。":[0,51.45,3.332],"他忙不迭地向大家道歉。":[0,55.132,3.175],"汤姆和玛丽就是没法儿和睦相处。":[0,58.658,4.154],"他们一家人很和睦。":[0,63.162,2.699],"邻居之间要和睦相处。":[0,66.211,3.042],"我对此一窍不通。":[0,69.603,2.377],"我把亚当的手表弄坏了，气得他七窍生烟。":[0,72.33,5.091],"学习汉语有什么窍门？":[0,77.771,3.044],"我一天吃了三次黑米粥！":[0,81.166,3.165],"我每天早晨吃一碗麦片粥。":[0,84.681,3.471],"唯有加很多糖才能让我喝得下粥。":[0,88.502,4.069],"他经历了人生的沧桑。":[0,92.921,2.954],"沧海桑田，变化真大。":[0,96.225,2.977],"这位老人的脸上写满了沧桑。":[0,99.552,3.517],"他怠忽职守了。":[1,0.05,2.121],"他工作很怠慢。":[1,2.521,2.191],"对客人不能怠慢。":[1,5.062,2.266],"我喉咙痛。":[1,7.678,1.518],"汤姆喉咙疼。":[1,9.546,1.879],"他清了清喉咙。":[1,11.775,2.155],"我要戴头盔。":[1,14.279,1.791],"他重新戴上了他的头盔。":[1,16.42,3.023],"维京人其实不戴有角的头盔。":[1,19.793,3.697],"他竖起了大拇指。":[1,23.841,2.406],"我的拇指受伤了。":[1,26.597,2.293],"他竖起大拇指说：“好！”":[1,29.24,2.979],"我小睡后就感到精力充沛。":[1,32.569,3.626],"他不像从前那样精力充沛了。":[1,36.546,3.886],"他精力充沛。":[1,40.781,1.919],"您新买的是辆崭新的车吗？":[1,43.051,3.489],"他穿着一身崭新的衣服。":[1,46.889,3.19],"这是一个崭新的开始。":[1,50.429,2.921],"他向女王鞠躬。":[1,53.7,2.083],"男孩向我鞠了个躬。":[1,56.133,2.445],"在日本，遇到人鞠躬是有礼貌的表现。":[1,58.928,4.362],"农民们开垦了一片荒地。":[1,63.64,2.811],"他在北方垦荒。":[1,66.801,2.157],"这片土地还没有开垦。":[1,69.308,2.994],"他们相处融洽。":[1,72.652,2.145],"他到名古屋洽谈业务。":[1,75.147,2.993],"我们正在和他们洽谈合作。":[1,78.49,3.485],"我瞧了瞧橱柜。":[1,82.325,2.091],"这房间有两个衣橱。":[1,84.765,2.617],"打开左边的橱，瓶子在那儿。":[1,87.732,3.364],"我怕蜘蛛。":[2,0.05,1.52],"汤姆恨蜘蛛。":[2,1.92,1.894],"蜘蛛吃什么？":[2,4.164,1.748],"穿上丝袜！":[2,6.262,1.668],"把袜子脱掉。":[2,8.28,1.799],"他喜欢穿短袜。":[2,10.429,2.227],"两座山峰对峙着。":[2,13.006,2.53],"两国军队在边境对峙。":[2,15.886,3.212],"两座高楼隔街对峙。":[2,19.449,2.773],"他寄给我一张请柬。":[2,22.572,2.684],"我收到了婚礼的请柬。":[2,25.606,2.876],"柬埔寨在东南亚。":[2,28.832,2.494],"夏天，树上的蝉叫个不停。":[2,31.675,3.322],"这只蝉很大。":[2,35.348,1.94],"他在树上抓了一只蝉。":[2,37.638,2.905],"秋天的螃蟹很好吃。":[2,40.893,2.974],"我们去海边抓螃蟹吧。":[2,44.217,2.876],"螃蟹是横着走的。":[2,47.443,2.404],"请关闭引擎。":[2,50.196,1.996],"引擎运转良好。":[2,52.542,2.292],"汤姆发动了引擎。":[2,55.185,2.229],"我会留疤吗？":[2,57.764,1.739],"他额头上的疤痕很醒目。":[2,59.853,3.345],"我还留着那起事故的伤疤。":[2,63.548,3.259],"把锅铲递给我。":[2,67.157,2.122],"汤姆握紧了铲子。":[2,69.629,2.332],"汤姆在外头铲雪。":[2,72.31,2.57],"铅笔头钝了。":[2,75.231,1.827],"我的剑虽然是钝的，但应付你的话是绰绰有余的。":[2,77.407,5.524],"我的刀变钝了。":[2,83.281,1.884]}}
